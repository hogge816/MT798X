# High-power radio overlay, applied AFTER mt7986-clx-s20p.config.
# Match hxlls/ci-immo configs/base.config: this firmware bundle contains
# MT7986_iPAiLNA_EEPROM_AX6000.bin, consumed by mt_wifi patch 048.
# Keep ordinary S20P builds on their existing firmware/calibration path.
# CONFIG_MTK_MT_WIFI_MT7986_20260601 is not set
CONFIG_MTK_MT_WIFI_MT7986_20240823=y
CONFIG_MTK_MT_WIFI_FIRMWARE_PATH_MT7986="mt7986-fw-20240823"
CONFIG_MTK_FIRST_IF_IPAILNA=y
CONFIG_MTK_FIRST_IF_EEPROM_FLASH=y
CONFIG_MTK_WIFI_FW_BIN_LOAD=y
